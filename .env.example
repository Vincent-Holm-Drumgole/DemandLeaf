# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Must match Clerk JWT template issuer used by Convex auth provider.
# Example: https://your-instance.clerk.accounts.dev
CLERK_ISSUER_URL=

# Stripe billing (GTM)
# Set to true only after Stripe product, recurring price, and webhook are live.
NEXT_PUBLIC_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (text-embedding-3-small for knowledge base vector search)
OPENAI_API_KEY=sk-...

# Upstash Redis (distributed rate limiting — required in production)
# Without these, rate limiting falls back to per-process in-memory storage,
# which is not shared across serverless instances.
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# PostHog (analytics)
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=

# DataForSEO (keyword research, SERP data, competitor analysis — Phase 3)
# Pay-as-you-go: $50 minimum, no subscription. https://dataforseo.com
DATAFORSEO_LOGIN=your-email@example.com
DATAFORSEO_PASSWORD=your-password

# WordPress publishing (Phase 5)
# 32+ character secret used for AES-256-GCM encryption.
WP_CREDENTIALS_KEY=replace-with-32-char-secret

# Google integrations (Phase 6)
# 32+ character secret used for AES-256-GCM encryption.
GOOGLE_TOKENS_KEY=replace-with-32-char-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-auth/callback
# Optional but recommended: dedicated HMAC secret for OAuth state signing.
# If omitted, GOOGLE_CLIENT_SECRET is used as fallback.
GOOGLE_OAUTH_STATE_SECRET=replace-with-strong-random-secret

# Inngest cron/worker authorization (Phase 6)
# Shared between Next.js runtime and Convex requireCronAccess checks.
INNGEST_CRON_KEY=replace-with-strong-random-secret

# Agent digest email (Phase 7)
RESEND_API_KEY=
RESEND_FROM_EMAIL=DemandLeaf <noreply@demandleaf.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
